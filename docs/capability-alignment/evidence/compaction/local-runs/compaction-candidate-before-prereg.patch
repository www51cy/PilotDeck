+test("three consecutive summary failures open a circuit with one half-open probe", async () => {
+  let now = 1_000_000;
+  let calls = 0;
+  let releaseProbe: (() => void) | undefined;
+  const engine = new CompactionEngine({
+    now: () => new Date(now),
+    model: {
+      async *stream(): AsyncIterable<CanonicalModelEvent> {
+        calls += 1;
+        if (calls <= 3) {
+          throw new Error("summary backend down");
+        }
+        yield { type: "text_delta", text: "## Objective\nRecovered." };
+        yield { type: "message_end", finishReason: "stop" };
+        if (calls === 4) {
+          await new Promise<void>((resolve) => { releaseProbe = resolve; });
+        }
+      },
+    },
+    provider: "local",
+    model_: "local-chat",
+  });
+  const run = (trigger: "auto" | "manual" = "auto") => engine.run({
+    trigger,
+    messages: compactFixture(),
+    keepTailRatio: 0.01,
+  });
+
+  await run();
+  now += 61_000;
+  await run();
+  now += 61_000;
+  await run();
+  const blocked = await run();
+  assert.equal(calls, 3);
+  assert.match(blocked.error ?? "", /circuit breaker is open/);
+
+  now += 300_001;
+  const probe = run();
+  await new Promise((resolve) => setImmediate(resolve));
+  const concurrent = await run();
+  assert.equal(calls, 4);
+  assert.match(concurrent.error ?? "", /half-open probe is already running/);
+  releaseProbe?.();
+  const recovered = await probe;
+  assert.equal(recovered.error, undefined);
+
+  const afterSuccess = await run();
+  assert.equal(afterSuccess.error, undefined);
+  assert.equal(calls, 5);
+});
+
+test("manual compaction is an explicit recovery exit from the failure circuit", async () => {
+  let now = 1_000_000;
+  let calls = 0;
+  const engine = new CompactionEngine({
+    now: () => new Date(now),
+    model: {
+      async *stream(): AsyncIterable<CanonicalModelEvent> {
+        calls += 1;
+        if (calls <= 3) throw new Error("summary backend down");
+        yield { type: "text_delta", text: "## Objective\nManual recovery." };
+        yield { type: "message_end", finishReason: "stop" };
+      },
+    },
+    provider: "local",
+    model_: "local-chat",
+  });
+  for (let attempt = 0; attempt < 3; attempt += 1) {
+    await engine.run({ trigger: "auto", messages: compactFixture(), keepTailRatio: 0.01 });
+    now += 61_000;
+  }
+  assert.equal(calls, 3);
+
+  const recovered = await engine.run({ trigger: "manual", messages: compactFixture(), keepTailRatio: 0.01 });
+  assert.equal(recovered.error, undefined);
+  assert.equal(calls, 4);
+});
